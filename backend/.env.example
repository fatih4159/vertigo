APP_ENV=production
DEBUG=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cynefa_db
POSTGRES_USER=cynefa
POSTGRES_PASSWORD=your_strong_password_here

REDIS_URL=redis://redis:6379/0

JWT_SECRET=your_very_strong_jwt_secret_here_min_32_chars

PIPEDRIVE_API_TOKEN=your_pipedrive_api_token
PIPEDRIVE_PIPELINE_ID=1
PIPEDRIVE_STAGE_ID=1

SCRAPING_ENABLED=true
HEADLESS_BROWSER=true
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MAX_RETRIES=3
SCRAPER_MIN_DELAY_SECONDS=2.0
SCRAPER_MAX_DELAY_SECONDS=6.0
SCREENSHOT_ON_ERROR=true
HTML_SNAPSHOT_ON_ERROR=true
SCREENSHOT_DIR=/tmp/cynefa_screenshots
