# Application
APP_NAME="AAOS - AGI Agent Operating System"
APP_VERSION="1.0.0"
DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database
DATABASE_URL=sqlite+aiosqlite:///./aaos.db
DATABASE_ECHO=false

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:latest
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# Agent
AGENT_MAX_ITERATIONS=1000
AGENT_ITERATION_DELAY=1.0
AGENT_MAX_TOKENS=4096

# Security
WORKSPACE_ROOT=./workspace
SECRET_KEY=change-me-in-production

# Memory
SHORT_TERM_MAX_ENTRIES=50
MID_TERM_MAX_ENTRIES=200

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/aaos.log
